category Set
source P
carrier P {
 elements 0 1 2 3
}
witness W on P {
 observation Omega : P -> Y
 eval x |-> x % 2
}
equivalence R := kernel_pair(Omega)
quotient Q := P / R
witness Identity on P {
 observation Id : P -> Y
 eval x |-> x
}
image I := image(Id)
assert canonical_iso {
 Q ~= I
}
